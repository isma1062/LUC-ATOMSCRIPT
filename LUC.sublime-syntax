%YAML 1.2
---
# Sublime Text Syntax Definition for LUC and AtomScript
name: LUC
file_extensions:
  - luc
  - atom
scope: source.luc

contexts:
  main:
    # Incluir todas las reglas de resaltado. El orden es importante.
    - include: comments
    - include: keywords
    - include: storage-types
    - include: strings
    - include: html-tags
    - include: script-tag
    - include: style-tag
    - include: constants
    - include: variables
    
  # Regla para comentarios de una sola línea
  comments:
    - match: '//.*'
      scope: comment.line.double-slash.luc

  # Regla para los strings ("texto")
  strings:
    - match: '"'
      scope: string.quoted.double.luc
      push:
        - meta_scope: string.quoted.double.luc
        - match: '"'
          pop: true
        - include: string-interpolation # Para ${variable}

  # Resaltar ${variable} dentro de los strings
  string-interpolation:
    - match: '\${.*?}'
      scope: constant.character.escape.luc
      
  # Palabras clave principales de AtomScript
  keywords:
    - match: '\b(componente|vista|estilo|accion|entrada)\b'
      scope: keyword.control.luc
      
  # Definición de datos
  storage-types:
    - match: '\b(dato|set)\b'
      scope: storage.type.luc
      
  # Números y booleanos
  constants:
    - match: '\b(true|false)\b'
      scope: constant.language.luc
    - match: '\b[0-9]+\.?[0-9]*\b'
      scope: constant.numeric.luc
      
  # Nombres de variables y funciones
  variables:
    - match: '(\w+)\s*=' # Variable antes de un =
      captures:
        1: variable.luc
    - match: '(\w+)\s*\(' # Nombre de una función o componente
      captures:
        1: entity.name.function.luc
  
  # Resaltar etiquetas HTML estándar
  html-tags:
    - match: '</?\w+'
      scope: entity.name.tag.luc
    - match: '(?<=\w)\s+\w+=' # Atributos como class=
      scope: entity.other.attribute-name.luc

  # Manejo especial para <script>
  script-tag:
    - match: '<script.*?>'
      scope: entity.name.tag.luc
      push:
        - meta_content_scope: source.js
        - match: '(?i)(</script>)'
          captures:
            1: entity.name.tag.luc
          pop: true
        - include: 'scope:source.js'

  # Manejo especial para <style>
  style-tag:
    - match: '<style.*?>'
      scope: entity.name.tag.luc
      push:
        - meta_content_scope: source.css
        - match: '(?i)(</style>)'
          captures:
            1: entity.name.tag.luc
          pop: true
        - include: 'scope:source.css'